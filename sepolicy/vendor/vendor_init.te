rw_dir_file(vendor_init, sysfs_ged)

# Audio
set_prop(vendor_init, vendor_mtk_audiohal_prop)
set_prop(vendor_init, vendor_mtk_audio_prop)

# Mot props
set_prop(vendor_init, vendor_mot_prop)

# Sku prop
set_prop(vendor_init, vendor_sku_prop)

allow vendor_init nfc_device:chr_file getattr;

# Configure virtual memory during boot.
allow vendor_init vendor_proc_vm:file w_file_perms;
allow vendor_init proc_percpu_pagelist_high_fraction:file w_file_perms;

set_prop(vendor_init, system_mot_prop)
