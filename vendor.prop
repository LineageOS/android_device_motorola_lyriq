persist.vendor.camera3.pipeline.bufnum.min.high_ram.lcso=7
persist.vendor.camera3.pipeline.bufnum.min.high_ram.rrzo=5
persist.vendor.camera3.pipeline.bufnum.min.high_ram.rsso=6
